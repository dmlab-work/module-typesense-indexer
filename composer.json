{
    "name": "dmlab/module-typesense-indexer",
    "description": "Turns the Magento catalog into Typesense documents and owns the attribute→schema policy. Implements Magento's indexer contracts so catalogsearch_fulltext writes to Typesense: FAT documents, THIN schema, in-place flag PATCH instead of full reindex.",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "version": "0.1.1",
    "require": {
        "php": "~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": ">=103.0",
        "dmlab/module-typesense-core": "^0.1.1",
        "magento/module-catalog-search": ">=102.0",
        "magento/module-catalog": ">=104.0",
        "magento/module-catalog-inventory": ">=100.0",
        "magento/module-customer": ">=103.0",
        "magento/module-eav": ">=102.0",
        "magento/module-store": ">=101.0",
        "magento/module-search": ">=101.0",
        "magento/module-elasticsearch": ">=101.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DmLab\\TypesenseIndexer\\": ""
        }
    }
}
